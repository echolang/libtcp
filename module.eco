/*
 * libtcp: TCP sockets, readiness and length-prefixed frames for Echo.
 *
 * The platform layer is C behind one contract (c/tcp.h): c/posix.c on macOS
 * and Linux (epoll or kqueue), c/win32.c on Windows (Winsock, wepoll).
 * Deadlines, addresses, frames, the client side of an HTTP/1.1 exchange and the rest are Echo.
 * No TLS, and no HTTP server.
 */

#[module: "libtcp"]
#[version: "0.2.3"] // x-release-please-version
#[epm::echoc: ">=0.14.0"]
#[epm::license: "MIT"]
#[epm::description: "tcp sockets, readiness and length-prefixed frames for echolang"]

#[if: os == windows]
#[cc: sources ["c/win32.c", "c/wepoll/wepoll.c"]]
#[link: lib "ws2_32"]
#[else]
#[cc: sources "c/posix.c"]
#[end]
#[sources: ["src/*.eco", "src/frame/*.eco", "src/http1/*.eco"]]

#[target: test] {
    #[sources: "tests/*.eco"]
}
