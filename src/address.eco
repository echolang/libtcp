/**
 * IPv4, IPv6 and unix socket endpoints, and host names turned into them. A listener and a connect take an
 * `Address`; the names come in through `resolve`, which is a call of its own so it can be made
 * once, on another thread, or not at all.
 */

namespace tcp;

public enum Family
{
    case v4;
    case v6;

    /**
     * A unix domain socket: a path on this machine instead of an address and a port. Local
     * Postgres, MySQL and Redis listen on one.
     */
    case unix;
}

/**
 * One endpoint: an IPv4 or IPv6 address, a port, and for a link-local IPv6 address the scope
 * (the interface) it belongs to. Or a unix socket's path, with port 0.
 */
public struct Address
{
    public const Family $family;
    public const uint16 $port;
    public const uint32 $scope;

    /**
     * A unix socket's path; empty for IPv4 and IPv6, and for the unnamed client end of a unix
     * connection.
     */
    public const string $path;
    private uint8[16] $bytes;

    internal constructor(raw: const tcp_addr& $a)
    {
        $this->family = Family::from(wire: $a->family) ?? .v4;
        $this->port = $a->port;
        $this->scope = $a->scope;
        $this->bytes = $a->bytes;
        string $p = '';
        usize $i = 0;
        while ($i < 108 && $a->path[$i] != 0) {
            $p->push($a->path[$i]);
            $i = $i + 1;
        }
        $this->path = $p;
    }

    /**
     * The unix socket at `$path`, a file on this machine. A path that is empty or longer than
     * the platform takes (103 bytes on macOS, 107 on Linux and Windows) is refused when it is
     * bound or connected to.
     */
    public constructor(unix: const string& $path)
    {
        $this->family = Family::unix;
        $this->port = 0;
        $this->scope = 0;
        $this->path = $path;
    }

    /**
     * The loopback address on `$port`: 127.0.0.1, or ::1 for `.v6`.
     */
    public constructor(loopback: uint16 $port, Family $family = .v4)
    {
        $this->family = $family;
        $this->port = $port;
        $this->scope = 0;
        $this->path = '';
        if ($family == Family::v6) {
            $this->bytes[15] = 1;
        } else {
            $this->bytes[0] = 127;
            $this->bytes[3] = 1;
        }
    }

    /**
     * Every interface on `$port`: 0.0.0.0, or :: for `.v6` (which a dual-stack listener also
     * takes IPv4 connections on).
     */
    public constructor(any: uint16 $port, Family $family = .v4)
    {
        $this->family = $family;
        $this->port = $port;
        $this->scope = 0;
        $this->path = '';
    }

    /**
     * A numeric address with no lookup: `127.0.0.1`, `::1`, `fe80::1%en0`.
     */
    public static function parse(const string& $ip, uint16 $port) : result<Address, Error>
    {
        if ($ip->empty()) {
            return .error(.invalid('an address is needed: 0.0.0.0 or :: for every interface'));
        }

        string $text = cstrOf($ip);
        tcp_addr $raw = tcp_addr();
        tcp_err $err = tcp_err();
        if (tcp_parse($text->cstr(), $port as int32, &$raw, &$err) < 0) {
            return .error(.invalid("not a numeric address: {$ip}"));
        }

        return .ok(Address(raw: $raw));
    }

    /**
     * `host:port` with a numeric host, the IPv6 one in brackets: `127.0.0.1:80`, `[::1]:80`.
     * Without brackets an IPv6 address is refused, not split at its last colon: `1::2:3` is an
     * address of its own, not `[1::2]:3`. `unix:/path` is a unix socket, the way one prints.
     */
    public static function parse(const string& $text) : result<Address, Error>
    {
        if ($text->starts('unix:')) {
            Address $u = Address(unix: $text->sub(5, $text->size() - 5));
            guard unixPath($u) else ($e) {
                return .error($e);
            }
            return .ok($u);
        }

        string $host = '';
        usize $colon = 0;
        bool $bracketed = $text->starts('[');
        if ($bracketed) {
            usize $close = $text->find(']');
            if ($close == $text->size() || $close + 1 == $text->size() || $text->byte($close + 1) != 58) {
                return .error(.invalid("no port in {$text}: write [host]:port"));
            }
            $host = $text->sub(1, $close - 1);
            $colon = $close + 1;
        } else {
            $colon = $text->find(':');
            if ($colon == $text->size()) {
                return .error(.invalid("no port in {$text}: write host:port"));
            }
            $host = $text->sub(0, $colon);
            if ($text->find(':', $colon + 1) != $text->size()) {
                return .error(.invalid("an IPv6 address goes in brackets, [host]:port: {$text}"));
            }
        }

        string $digits = $text->sub($colon + 1, $text->size() - $colon - 1);
        uint16 $port = guard portOf($digits) else {
            return .error(.invalid("not a port 0..65535: {$digits}"));
        }

        Address $a = guard Address::parse($host, $port) else ($e) {
            return .error($e);
        }
        if ($bracketed && $a->family != Family::v6) {
            return .error(.invalid("brackets are for an IPv6 address: {$text}"));
        }
        return .ok($a);
    }

    /**
     * The same address on another port.
     */
    public const function with(port: uint16 $port) : Address
    {
        tcp_addr $raw = $this->raw();
        $raw->port = $port;
        return Address(raw: $raw);
    }

    /**
     * The address without its port: `127.0.0.1`, `::1`, `fe80::1%en0`, or a unix socket's path.
     */
    public const function host() : string
    {
        if ($this->family == Family::unix) {
            return $this->path;
        }
        tcp_addr $raw = $this->raw();
        string $text = '';
        $text->reserve(64);
        int32 $n = tcp_addr_text(&$raw, $text->spare(), 64);
        if ($n > 0) {
            $text->commit($n as usize);
        }
        return $text;
    }

    internal const function raw() : tcp_addr
    {
        tcp_addr $raw = tcp_addr();
        $raw->family = $this->family->wire();
        $raw->port = $this->port;
        $raw->scope = $this->scope;
        $raw->bytes = $this->bytes;
        // a path that does not fit is cut, and refused before it gets here (`unixPath`)
        usize $i = 0;
        while ($i < $this->path->size() && $i < 107) {
            $raw->path[$i] = $this->path->byte($i);
            $i = $i + 1;
        }
        return $raw;
    }

    /**
     * True for 0.0.0.0 and ::, which a listener binds to mean every interface.
     */
    internal const function unspecified() : bool
    {
        if ($this->family == Family::unix) {
            return false;
        }
        usize $i = 0;
        while ($i < 16) {
            if ($this->bytes[$i] != 0) {
                return false;
            }
            $i = $i + 1;
        }
        return true;
    }

    internal const function same(const Address& $other) : bool
    {
        if ($this->family != $other->family || $this->port != $other->port || $this->scope != $other->scope) {
            return false;
        }
        if ($this->path != $other->path) {
            return false;
        }

        return mem::compare_bytes(&$this->bytes[0], &$other->bytes[0], 16) == 0;
    }

    internal const function digest() : uint64
    {
        uint64 $h = hash::combine(hash::of($this->port as uint64), hash::of($this->scope as uint64));
        $h = hash::combine($h, hash::of($this->path));
        return hash::bytes(&$this->bytes[0], 16, $h);
    }
}

/**
 * `.invalid` unless `$a` is a unix socket path the platform takes: not empty, no NUL byte, and
 * short enough for its `sockaddr_un`.
 */
internal function unixPath(const Address& $a) : status<Error>
{
    usize $max = tcp_unix_path_max() as usize;
    if ($a->path->empty() || $a->path->size() > $max) {
        return .error(.invalid("a unix socket path is 1 to {$max} bytes: '{$a->path}'"));
    }
    if ($a->path->find('\0') != $a->path->size()) {
        return .error(.invalid('a unix socket path cannot hold a NUL byte'));
    }
    return .ok;
}

/**
 * A port written in decimal digits and nothing else (no sign, no space), 0..65535, or null.
 */
internal function portOf(const string& $digits) : uint16?
{
    uint16? $none = null;
    if ($digits->empty() || $digits->size() > 5) {
        return $none;
    }
    uint32 $n = 0;
    usize $i = 0;
    while ($i < $digits->size()) {
        uint8 $b = $digits->byte($i);
        if ($b < 48 || $b > 57) {
            return $none;
        }
        $n = $n * 10 + (($b - 48) as uint32);
        $i = $i + 1;
    }
    if ($n > 65535) {
        return $none;
    }
    uint16? $port = $n as uint16;
    return $port;
}

operator (Address $l) == (Address $r) : bool
{
    return $l->same($r);
}

operator (Address $l) != (Address $r) : bool
{
    return !$l->same($r);
}

/**
 * The addresses `$host` resolves to for `$port`, in the order the system prefers them. A numeric
 * host resolves to itself without a lookup. The lookup is not bounded by any deadline: resolve
 * on a thread of its own where a slow resolver must not stall the caller.
 */
public function resolve(const string& $host, uint16 $port) : result<array<Address>, Error>
{
    return lookup($host, $port, passive: false);
}

/**
 * `resolve`, or with `passive` the addresses to listen on.
 */
internal function lookup(const string& $host, uint16 $port, passive: bool $passive) : result<array<Address>, Error>
{
    if ($host->empty()) {
        return .error(.invalid('a host is needed: 0.0.0.0 or :: for every interface'));
    }

    string $name = cstrOf($host);
    array<tcp_addr> $raw = arr::room<tcp_addr>(RESOLVE_MAX as usize);
    tcp_err $err = tcp_err();
    int32 $passiveFlag = 0;
    if ($passive) {
        $passiveFlag = 1;
    }
    int32 $n = tcp_resolve($name->cstr(), $port as int32, $passiveFlag, $raw->spare(), RESOLVE_MAX, &$err);
    if ($n < 0) {
        Kind $kind = Kind::from(code: $err->kind) ?? .other;
        if ($kind == Kind::resolve) {
            return .error(.resolve($host, errorText($err)));
        }
        return .error(failure(.resolve, $err));
    }

    $raw->commit($n as usize);
    array<Address> $out = arr::room<Address>($n as usize);
    foreach ($raw as $a) {
        $out[] = Address(raw: $a);
    }
    return .ok($out);
}
