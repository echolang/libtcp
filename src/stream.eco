/**
 * One TCP connection. `#[atomic]` so an accept thread can hand it to the thread that serves it,
 * and one thread may read while another writes. `close` is safe from any thread at any time: it
 * wakes every call blocked on the stream, and the descriptor is released once the last of them
 * has left.
 */

namespace tcp;

use std::time;

// why a local address and a unix socket do not go together, wherever either side is one
internal const string LOCAL_NOT_UNIX = 'a local address binds a TCP connect, not a unix socket';

/**
 * Which side of a stream a `shutdown` closes.
 */
public enum Direction
{
    case read;
    case write;
    case both;
}

/**
 * Two ends of one loopback connection, from `Stream::pair`.
 */
public struct StreamPair
{
    /**
     * The end that connected.
     */
    public Stream $client;

    /**
     * The end the listener accepted.
     */
    public Stream $server;
}

#[atomic]
public class Stream : Source, Sink, Pollable
{
    public const Address $local;
    public const Address $peer;
    private const int64 $fd;
    private Gate $gate;
    // the pollers watching the descriptor, which `release` takes it out of
    private const Watchers $watchers;

    internal constructor(int64 $fd, Address $local, Address $peer)
    {
        $this->fd = $fd;
        $this->local = $local;
        $this->peer = $peer;
        $this->gate = Gate();
        $this->watchers = Watchers();
    }

    destructor()
    {
        if (!$this->gate->released()) {
            tcp_close($this->fd);
        }
    }

    /**
     * Connect to `$to` before the deadline.
     */
    public static function connect(const Address& $to, Deadline $by, StreamOptions $options = StreamOptions()) : result<Stream, Error>
    {
        if ($to->family == Family::unix) {
            guard unixPath($to) else ($e) {
                return .error($e);
            }
        } else if ($to->port == 0) {
            return .error(.invalid('a connect needs a port: 1..65535'));
        }

        tcp_addr $from = guard Stream::localFor($to, $options) else ($e) {
            return .error($e);
        }
        tcp_addr $raw = $to->raw();
        tcp_err $err = tcp_err();
        int64 $fd = tcp_connect(&$raw, &$from, $by->ms(), &$err);
        if ($fd == TCP_TIMEOUT) {
            return .error(.timeout);
        }
        if ($fd < 0) {
            return .error(failure(.connect, $err));
        }

        return Stream::adopt($fd, $to, $options, .connect);
    }

    /**
     * Start connecting to `$to` without waiting: register the `Connecting` with a `Poller` for
     * `.write`, and call `tryFinish` when it reports.
     */
    public static function start(const Address& $to, StreamOptions $options = StreamOptions()) : result<Connecting, Error>
    {
        if ($to->family == Family::unix) {
            guard unixPath($to) else ($e) {
                return .error($e);
            }
        } else if ($to->port == 0) {
            return .error(.invalid('a connect needs a port: 1..65535'));
        }

        tcp_addr $from = guard Stream::localFor($to, $options) else ($e) {
            return .error($e);
        }
        tcp_addr $raw = $to->raw();
        tcp_err $err = tcp_err();
        int32 $done = 0;
        int64 $fd = tcp_connect_start(&$raw, &$from, &$done, &$err);
        if ($fd < 0) {
            return .error(failure(.connect, $err));
        }
        return .ok(Connecting($fd, $to, $options, $done != 0));
    }

    /**
     * Resolve `$host` and connect to whichever of its addresses answers first, all before the
     * one deadline. The lookup is bounded by it too. Addresses race Happy Eyeballs (RFC 8305):
     * families take turns, a new attempt every `$stagger` or as soon as the latest fails, so one
     * address that drops packets cannot use up the deadline. A failure is the last attempt's.
     * With `$options->local` set, only the addresses of its family are tried. A local address
     * with a port of its own takes them one at a time instead, each once the one before failed:
     * two attempts cannot bind one port at once. Then an address that drops packets can use up
     * the deadline.
     */
    public static function connect(host: const string& $host, uint16 $port, Deadline $by, StreamOptions $options = StreamOptions(), stagger: time::duration $stagger = time::duration::millis(250)) : result<Stream, Error>
    {
        if ($port == 0) {
            return .error(.invalid('a connect needs a port: 1..65535'));
        }
        // checked before the lookup: a unix one fails at once, and with its own reason
        Address? $bound = guard Stream::boundTcp($options) else ($e) {
            return .error($e);
        }

        array<Address> $addrs = guard resolve($host, $port, $by) else ($e) {
            return .error($e);
        }
        Address $local = guard $bound else {
            return connectAll($addrs, $by, $options, $stagger);
        }
        array<Address> $same = array<Address>();
        foreach ($addrs as const &$a) {
            if ($a->family == $local->family) {
                $same[] = $a;
            }
        }
        if ($same->empty()) {
            return .error(.invalid("{$host} has no address of the local address's family"));
        }
        if ($local->port == 0) {
            return connectAll($same, $by, $options, $stagger);
        }

        // one port binds one attempt at a time: a second would fail with EADDRINUSE at once
        Error $last = .timeout;
        foreach ($same as const &$a) {
            result<Stream, Error> $one = Stream::connect($a, $by, $options);
            if ($one->has_value()) {
                return $one;
            }
            $last = $one->failure();
            if ($by->passed()) {
                break;
            }
        }
        return .error($last);
    }

    /**
     * Take over a connected socket that another library made (its accept, say), whatever state
     * it is in: it is made non-blocking and kept from child processes like every socket libtcp
     * opens (and SIGPIPE-free on macOS), both endpoints are read from the OS, and `$options` are
     * applied. The stream owns the descriptor from here on and closes it, unless `release` hands
     * it back. On a failure the descriptor is closed.
     */
    public static function adopt(fd: int64 $fd, StreamOptions $options = StreamOptions()) : result<Stream, Error>
    {
        if ($fd < 0) {
            return .error(.invalid('adopt needs an open descriptor'));
        }
        tcp_addr $raw = tcp_addr();
        tcp_err $err = tcp_err();
        if (tcp_adopt($fd, &$raw, &$err) < 0) {
            tcp_close($fd);
            return .error(failure(.accept, $err));
        }
        Address $peer = Address(raw: $raw);
        return Stream::adopt($fd, $peer, $options, .accept);
    }

    /**
     * Take over a socket its maker already keeps from child processes and from SIGPIPE, as
     * libhttp's accept does, with both endpoints as the maker knows them: only O_NONBLOCK is
     * set, one call where `adopt(fd:)` makes five. For a hand-over on every request. The stream
     * reports `$peer` and `$local` as given; the OS is not asked. On a failure the descriptor is
     * closed.
     */
    public static function adopt(fd: int64 $fd, peer: Address $peer, local: Address $local, StreamOptions $options = StreamOptions()) : result<Stream, Error>
    {
        if ($fd < 0) {
            return .error(.invalid('adopt needs an open descriptor'));
        }
        tcp_err $err = tcp_err();
        if (tcp_blocking($fd, 0, &$err) < 0) {
            tcp_close($fd);
            return .error(failure(.accept, $err));
        }
        return Stream::adopt($fd, $peer, $options, .accept, $local);
    }

    /**
     * Two streams connected to each other over loopback, both set up before the deadline: for
     * tests, and for two parts of one process that talk TCP. The listener in between is closed
     * before this returns.
     */
    public static function pair(Deadline $by) : result<StreamPair, Error>
    {
        Listener $l = guard Listener::bind(Address(loopback: 0)) else ($e) {
            return .error($e);
        }
        Stream $client = guard Stream::connect($l->local, $by) else ($e) {
            $l->close();
            return .error($e);
        }

        while (true) {
            Stream? $maybe = guard $l->accept($by) else ($e) {
                $l->close();
                $client->close();
                return .error($e);
            }
            Stream $server = guard $maybe else {
                $l->close();
                $client->close();
                return .error(.timeout);
            }
            // another process may have raced to the port: only the client's own connection pairs
            if ($server->peer == $client->local) {
                $l->close();
                return .ok(StreamPair($client, $server));
            }
            $server->close();
        }
    }

    /**
     * A stream around a connected descriptor, its options applied. The local endpoint is read
     * from the OS unless the caller already knows it (an accept on a listener bound to one
     * address). `$op` names the call that produced the descriptor, for a failure here.
     */
    internal static function adopt(int64 $fd, const Address& $peer, const StreamOptions& $options, Op $op, Address? $local = null) : result<Stream, Error>
    {
        Address? $known = $local;
        if ($known == null) {
            tcp_addr $raw = tcp_addr();
            tcp_err $err = tcp_err();
            if (tcp_local($fd, &$raw, &$err) < 0) {
                tcp_close($fd);
                return .error(failure($op, $err));
            }
            $known = Address(raw: $raw);
        }

        Address $at = guard $known;
        Stream $s = Stream($fd, $at, $peer);
        guard $s->apply($options) else ($e) {
            $s->close();
            return .error($e);
        }
        return .ok($s);
    }

    internal function apply(const StreamOptions& $options) : status<Error>
    {
        // no-delay and keepalive are TCP's: a unix socket has neither, and skips them
        bool $tcp = $this->peer->family != Family::unix;
        // off is how the OS hands a socket over: only on costs a call
        if ($tcp && $options->noDelay) {
            guard $this->noDelay(true) else ($e) {
                return .error($e);
            }
        }
        time::duration? $idle = $options->keepAlive;
        if ($tcp && $idle != null) {
            guard $this->keepAlive($idle) else ($e) {
                return .error($e);
            }
        }
        if ($options->sendBuffer > 0 || $options->receiveBuffer > 0) {
            guard $this->buffers(send: $options->sendBuffer, receive: $options->receiveBuffer) else ($e) {
                return .error($e);
            }
        }
        return .ok;
    }

    /**
     * Read at most `$most` bytes onto the end of `$into`: how many arrived, or null when the
     * deadline passed with nothing (nothing lost; call again). `.eof` once the peer has closed.
     */
    public function read(string& $into, usize $most, Deadline $by) : result<usize?, Error>
    {
        if ($this->gate->has(GATE_READ_SHUT)) {
            return .error(.closed);
        }
        return $this->receive($into, $most, $by);
    }

    /**
     * Read whatever is already here without waiting: how many bytes, or null when there is
     * nothing yet. For a reactor that waits on a `Poller` instead.
     */
    public function tryRead(string& $into, usize $most) : result<usize?, Error>
    {
        if ($this->gate->has(GATE_READ_SHUT)) {
            return .error(.closed);
        }
        return $this->receive($into, $most, null);
    }

    /**
     * Send every byte of `$bytes` before the deadline, so a peer that reads a byte at a time
     * cannot hold the writer past it. A `.timeout` leaves an unknown part sent and breaks the
     * write side: every later write is `.broken`.
     */
    public function write(const string& $bytes, Deadline $by) : status<Error>
    {
        string $none = '';
        return $this->gather($bytes, $none, $by);
    }

    /**
     * Send `$head` then `$body` in one gathered write (one packet when they fit), before the
     * deadline. Neither is copied.
     */
    public function write(const string& $head, const string& $body, Deadline $by) : status<Error>
    {
        return $this->gather($head, $body, $by);
    }

    /**
     * Send what fits without waiting, from `$from` on in `$bytes`: how many bytes went, or null
     * when nothing could. A partial send is normal; the reactor keeps the offset.
     */
    public function tryWrite(const string& $bytes, usize $from = 0) : result<usize?, Error>
    {
        string $none = '';
        return $this->tryGather($bytes, $none, $from);
    }

    /**
     * Send what fits of `$head` then `$body` without waiting, as one gathered write, neither
     * copied. `$from` counts across both, so a reactor keeps one offset for the pair: how many
     * bytes went, or null when nothing could.
     */
    public function tryWrite(const string& $head, const string& $body, usize $from = 0) : result<usize?, Error>
    {
        return $this->tryGather($head, $body, $from);
    }

    /**
     * A socket keeps nothing of its own back: there is never anything to flush.
     */
    public function tryFlush() : result<bool, Error>
    {
        return .ok(true);
    }

    /**
     * A plain socket needs exactly what the caller wants.
     */
    public const function needs(Interest? $want) : Interest?
    {
        return $want;
    }

    /**
     * Shut one direction or both. After `.write` the peer reads the end of the stream while
     * this side can still read. A read after `.read` or `.both` is `.closed`, and so is a write
     * after `.write` or `.both`. The read side is this stream's alone: the peer is not told, and
     * bytes it still sends wait unread (a `close` with them there is a reset). A direction shut
     * already stays shut: asking again is not an error.
     */
    public function shutdown(Direction $which) : status<Error>
    {
        if (!$this->gate->enter()) {
            return .error(.closed);
        }

        // only what is still open is shut: macOS refuses a second shutdown of one direction
        // (ENOTCONN), which would read as the peer gone
        bool $read = $which != Direction::write && !$this->gate->has(GATE_READ_SHUT);
        bool $write = $which != Direction::read && !$this->gate->has(GATE_WRITE_SHUT);
        if (!$read && !$write) {
            bool $gone = $this->leave();
            if ($gone) {
                return .error(.closed);
            }
            return .ok;
        }

        // the read side is shut here, not in the OS: after an OS read shutdown, bytes the peer
        // still sends make macOS and Windows reset the connection, which takes the write side
        // down with it, and Linux goes on handing them out
        tcp_err $err = tcp_err();
        int32 $rc = 0;
        if ($write) {
            $rc = tcp_shutdown($this->fd, Direction::write->wire(), &$err);
        }
        // only a shutdown that happened makes later calls `.closed`; a failed one leaves them to
        // find the real state
        if ($rc == 0 && $write) {
            $this->gate->mark(GATE_WRITE_SHUT);
        }
        if ($rc == 0 && $read) {
            $this->gate->mark(GATE_READ_SHUT);
        }
        bool $closed = $this->leave();

        if ($rc < 0) {
            return .error(outcome(.shutdown, TCP_ERR, $err, $closed));
        }
        return .ok;
    }

    /**
     * Close gracefully: shut the write side, then read and drop whatever the peer still sends
     * until it closes too or the deadline passes, then close. A plain `close` with unread bytes
     * waiting makes the OS reset the connection, and a reset can destroy the reply the peer has
     * not read yet; `finish` does not.
     */
    public function finish(Deadline $by) : status<Error>
    {
        if ($this->gate->has(GATE_CLOSED)) {
            return .error(.closed);
        }
        status<Error> $shut = $this->shutdown(.write);
        if (!$shut->has_value()) {
            // the peer is gone already (a reset): nothing is left to drain
            $this->close();
            return .ok;
        }

        // `receive`, not `read`: a read side this stream shut still has to be drained
        string $drop = '';
        while (true) {
            $drop->clear();
            result<usize?, Error> $got = $this->receive($drop, 65536, $by);
            if (!$got->has_value()) {
                // the end of the stream, or a reset: either way the peer is done
                $this->close();
                return .ok;
            }
            if ($got->unwrap() == null || $by->passed()) {
                $this->close();
                return .error(.timeout);
            }
        }
    }

    /**
     * Close the stream, from any thread. Calls blocked on it wake and answer `.closed`, and so
     * does every call after. The descriptor is released at once when no call is inside, else
     * by the last one out.
     */
    public function close() : void
    {
        int32 $inside = $this->gate->shut();
        if ($inside < 0) {
            return;
        }
        if ($inside > 0) {
            tcp_cancel($this->fd);
        }
        $this->leave();
    }

    public const function closed() : bool
    {
        return $this->gate->has(GATE_CLOSED);
    }

    /**
     * Give the descriptor back without closing it, to hand the connection to other code (the
     * library it was adopted from). The stream is closed for every call after, but the
     * descriptor stays open and is the caller's to close. It is still non-blocking unless
     * `$blocking` asks for it blocking again. `.closed` when the stream is closed already, and
     * `.invalid` while another call is inside it: release from the one thread that drives it.
     * Every `Poller` watching the stream lets go of the descriptor first, so none goes on
     * reporting it to its new owner. Bytes a `Reader` read ahead stay in the reader.
     */
    public function release(blocking: bool $blocking = false) : result<int64, Error>
    {
        if (!$this->gate->seize()) {
            if ($this->gate->has(GATE_CLOSED)) {
                return .error(.closed);
            }
            return .error(.invalid('another call is inside the stream: it cannot be released under it'));
        }

        // seized: nothing else touches the descriptor, and the destructor leaves it open. A poller
        // would refuse a `remove` now (the stream is closed), so each forgets the descriptor here
        foreach ($this->watchers->take() as $p) {
            $p->forget($this->fd);
        }
        if ($blocking) {
            tcp_err $err = tcp_err();
            if (tcp_blocking($this->fd, 1, &$err) < 0) {
                // a descriptor nobody can use is closed, not leaked
                tcp_close($this->fd);
                return .error(failure(.option, $err));
            }
        }
        return .ok($this->fd);
    }

    /**
     * Send small writes at once (TCP_NODELAY). `.invalid` on a unix socket, which has no Nagle
     * delay to turn off.
     */
    public function noDelay(bool $on) : status<Error>
    {
        if ($this->peer->family == Family::unix) {
            return .error(.invalid('no-delay is a TCP option, not for a unix socket'));
        }
        int64 $v = 0;
        if ($on) {
            $v = 1;
        }
        return $this->option(TCP_OPT_NODELAY, $v);
    }

    /**
     * Probe the connection after `$idle` without traffic; null turns probing off. `.invalid` on a
     * unix socket, whose peer cannot vanish without the kernel knowing.
     */
    public function keepAlive(time::duration? $idle) : status<Error>
    {
        if ($this->peer->family == Family::unix) {
            return .error(.invalid('keepalive is a TCP option, not for a unix socket'));
        }
        int64 $secs = 0;
        if ($idle != null) {
            time::duration $d = guard $idle;
            $secs = $d->as_secs() as int64;
            if ($secs < 1) {
                $secs = 1;
            }
        }
        return $this->option(TCP_OPT_KEEPALIVE, $secs);
    }

    /**
     * Kernel buffer sizes in bytes; 0 leaves that one as it is.
     */
    public function buffers(send: usize $send, receive: usize $receive) : status<Error>
    {
        if ($send > 0) {
            guard $this->option(TCP_OPT_SEND_BUFFER, $send as int64) else ($e) {
                return .error($e);
            }
        }
        if ($receive > 0) {
            guard $this->option(TCP_OPT_RECV_BUFFER, $receive as int64) else ($e) {
                return .error($e);
            }
        }
        return .ok;
    }

    /**
     * The OS descriptor, for a `Poller` or another event loop. Valid while the stream is open.
     */
    public const function handle() : int64
    {
        return $this->fd;
    }

    /**
     * Keeps `$by`, so `release` can take the descriptor out of it.
     */
    public const function watched(const Poller& $by) : void
    {
        $this->watchers->add($by);
    }

    public const function unwatched(const Poller& $by) : void
    {
        $this->watchers->remove($by);
    }

    /**
     * Counts a call out of the gate, and releases the descriptor when it was the last one in after
     * a close. True when the stream was closed by the time the call left.
     */
    private function leave() : bool
    {
        Exit $exit = $this->gate->leave();
        if ($exit->last) {
            tcp_close($this->fd);
            // the OS dropped the descriptor from every poller with it
            $this->watchers->clear();
        }
        return $exit->closed;
    }

    private function option(int32 $opt, int64 $value) : status<Error>
    {
        if (!$this->gate->enter()) {
            return .error(.closed);
        }

        tcp_err $err = tcp_err();
        int32 $rc = tcp_set_option($this->fd, $opt, $value, &$err);
        bool $closed = $this->leave();

        if ($rc < 0) {
            return .error(outcome(.option, TCP_ERR, $err, $closed));
        }
        return .ok;
    }

    private function writable() : status<Error>
    {
        if ($this->gate->has(GATE_CLOSED | GATE_WRITE_SHUT)) {
            return .error(.closed);
        }
        if ($this->gate->has(GATE_BROKEN)) {
            return .error(.broken);
        }
        return .ok;
    }

    private function tryGather(const string& $head, const string& $body, usize $from) : result<usize?, Error>
    {
        usize? $none = null;
        guard $this->writable() else ($e) {
            return .error($e);
        }
        usize $headSize = $head->size();
        usize $total = $headSize + $body->size();
        if ($from >= $total) {
            usize $zero = 0;
            usize? $nothing = $zero;
            return .ok($nothing);
        }
        if (!$this->gate->enter()) {
            return .error(.closed);
        }

        $h = $head->data();
        $b = $body->data();
        usize $inHead = $this->clip($from, $headSize);
        usize $inBody = $from - $inHead;
        tcp_err $err = tcp_err();
        int64 $put = tcp_try_sendv($this->fd, $h:$ + $inHead, ($headSize - $inHead) as int64, $b:$ + $inBody, ($body->size() - $inBody) as int64, &$err);
        bool $closed = $this->leave();

        if ($put >= 0) {
            usize? $n = $put as usize;
            return .ok($n);
        }
        if ($put == TCP_AGAIN && !$closed) {
            return .ok($none);
        }
        return .error(outcome(.write, $put, $err, $closed));
    }

    private function gather(const string& $head, const string& $body, Deadline $by) : status<Error>
    {
        guard $this->writable() else ($e) {
            return .error($e);
        }
        usize $headSize = $head->size();
        usize $total = $headSize + $body->size();
        if ($total == 0) {
            return .ok;
        }
        if (!$this->gate->enter()) {
            return .error(.closed);
        }

        $h = $head->data();
        $b = $body->data();
        usize $off = 0;
        bool $first = true;
        tcp_err $err = tcp_err();
        int64 $put = 0;
        while ($off < $total) {
            int32 $ms = $by->ms();
            // the first send always runs, so a deadline that has passed still sends what fits
            if ($ms == 0 && !$first) {
                $put = TCP_TIMEOUT;
                break;
            }
            $first = false;

            usize $inHead = $this->clip($off, $headSize);
            usize $inBody = $off - $inHead;
            $put = tcp_sendv($this->fd, $h:$ + $inHead, ($headSize - $inHead) as int64, $b:$ + $inBody, ($body->size() - $inBody) as int64, $ms, &$err);
            if ($put < 0) {
                break;
            }
            $off = $off + ($put as usize);
        }
        bool $closed = $this->leave();

        if ($off == $total) {
            return .ok;
        }
        $this->gate->mark(GATE_BROKEN);
        return .error(outcome(.write, $put, $err, $closed));
    }

    /**
     * Both reads: wait up to `$by` for bytes, or not at all when there is no deadline.
     */
    private function receive(string& $into, usize $most, Deadline? $by) : result<usize?, Error>
    {
        if ($most == 0) {
            usize $zero = 0;
            usize? $nothing = $zero;
            return .ok($nothing);
        }
        if (!$this->gate->enter()) {
            return .error(.closed);
        }

        usize $grow = $most;
        if ($grow > READ_BIG) {
            $grow = READ_BIG;
        }
        if ($into->room() < $grow) {
            $into->reserve($into->size() + $grow);
        }
        usize $ask = $most;
        if ($ask > $into->room()) {
            $ask = $into->room();
        }
        tcp_err $err = tcp_err();
        Deadline $until = guard $by else {
            int64 $now = tcp_try_recv($this->fd, $into->spare(), $ask as int64, &$err);
            bool $shut = $this->leave();
            return $this->received($into, $now, $err, TCP_AGAIN, $shut);
        }

        int64 $got = TCP_AGAIN;
        bool $more = $this->gate->has(GATE_MORE);
        // last read filled the request, so more is likely waiting: skip the poll. Most reads
        // come after a request sent, when nothing is there yet; those poll first
        if ($more) {
            $got = tcp_try_recv($this->fd, $into->spare(), $ask as int64, &$err);
        }
        if ($got == TCP_AGAIN) {
            $got = tcp_recv($this->fd, $into->spare(), $ask as int64, $until->ms(), &$err);
        }
        bool $full = $got == ($ask as int64);
        if ($full != $more) {
            if ($full) {
                $this->gate->mark(GATE_MORE);
            } else {
                $this->gate->unmark(GATE_MORE);
            }
        }
        bool $closed = $this->leave();
        return $this->received($into, $got, $err, TCP_TIMEOUT, $closed);
    }

    /**
     * A read's outcome: the bytes it put on the end of `$into` (even when a close raced it), null
     * when `$quiet` (nothing yet) came back on a stream still open, else the failure.
     */
    private function received(string& $into, int64 $got, const tcp_err& $err, int64 $quiet, bool $closed) : result<usize?, Error>
    {
        if ($got > 0) {
            $into->commit($got as usize);
            usize? $n = $got as usize;
            return .ok($n);
        }
        if ($got == $quiet && !$closed) {
            usize? $none = null;
            return .ok($none);
        }
        return .error(outcome(.read, $got, $err, $closed));
    }

    /**
     * The local endpoint a connect to `$to` binds first, as C takes it: `$options->local`, or the
     * empty one (family 0) for none. `.invalid` for a unix one, or one of another family than
     * `$to`.
     */
    private static function localFor(const Address& $to, const StreamOptions& $options) : result<tcp_addr, Error>
    {
        Address? $bound = guard Stream::boundTcp($options) else ($e) {
            return .error($e);
        }
        Address $local = guard $bound else {
            return .ok(tcp_addr());
        }
        if ($to->family == Family::unix) {
            return .error(.invalid(LOCAL_NOT_UNIX));
        }
        if ($local->family != $to->family) {
            return .error(.invalid('the local address is not of the family connected to'));
        }
        return .ok($local->raw());
    }

    /**
     * `$options->local`, or null for none. `.invalid` for a unix one: it binds a TCP connect.
     */
    private static function boundTcp(const StreamOptions& $options) : result<Address?, Error>
    {
        Address? $bound = $options->local;
        if ($bound != null) {
            Address $local = guard $bound;
            if ($local->family == Family::unix) {
                return .error(.invalid(LOCAL_NOT_UNIX));
            }
        }
        return .ok($bound);
    }

    /**
     * How much of an offset across a head and body falls in the head.
     */
    private const function clip(usize $off, usize $headSize) : usize
    {
        if ($off < $headSize) {
            return $off;
        }
        return $headSize;
    }
}
