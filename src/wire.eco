/**
 * Fixed-width integers as wire protocols lay them out: big-endian (network order: frames,
 * Postgres) and little-endian (MySQL, most game protocols), read at an offset of a string (or of
 * a view, a reader's `window` say) and appended onto one. A read expects the bytes to be there;
 * check the size (or a reader's `buffered()`) first. One past the end stops the program, in a
 * release build too.
 */

namespace tcp::wire;

/**
 * Stops the program unless `$n` bytes of `$b` start at `$at`. A release build checks too: an
 * offset or a length a peer sent, used unchecked, would otherwise read heap memory past the
 * string as if it were the message.
 */
#[inline]
internal function need(string::view $b, usize $at, usize $n) : void
{
    if ($at > $b->size || $b->size - $at < $n) {
        die("tcp::wire: {$n} bytes at {$at} of a string of {$b->size}");
    }
}

#[inline]
public function be16(string::view $b, usize $at = 0) : uint16
{
    need($b, $at, 2);
    ptr<const uint8> $d = $b->bytes;
    return (($d:$[$at] as uint16) << 8) | ($d:$[$at + 1] as uint16);
}

#[inline]
public function be32(string::view $b, usize $at = 0) : uint32
{
    need($b, $at, 4);
    ptr<const uint8> $d = $b->bytes;
    return (($d:$[$at] as uint32) << 24) | (($d:$[$at + 1] as uint32) << 16) | (($d:$[$at + 2] as uint32) << 8) | ($d:$[$at + 3] as uint32);
}

#[inline]
public function be64(string::view $b, usize $at = 0) : uint64
{
    need($b, $at, 8);
    ptr<const uint8> $d = $b->bytes;
    uint64 $v = 0;
    usize $i = 0;
    while ($i < 8) {
        $v = ($v << 8) | ($d:$[$at + $i] as uint64);
        $i = $i + 1;
    }
    return $v;
}

// the little-endian reads are one checked load each: every target Echo builds for is
// little-endian and allows an unaligned load

#[inline]
public function le16(string::view $b, usize $at = 0) : uint16
{
    need($b, $at, 2);
    ptr<const uint8> $d = $b->bytes;
    ptr<const uint16> $w = ($d:$ + $at) as ptr<const uint16>;
    return $w:$[0];
}

/**
 * Three bytes, low first: MySQL's packet length.
 */
#[inline]
public function le24(string::view $b, usize $at = 0) : uint32
{
    need($b, $at, 3);
    ptr<const uint8> $d = $b->bytes;
    return ($d:$[$at] as uint32) | (($d:$[$at + 1] as uint32) << 8) | (($d:$[$at + 2] as uint32) << 16);
}

#[inline]
public function le32(string::view $b, usize $at = 0) : uint32
{
    need($b, $at, 4);
    ptr<const uint8> $d = $b->bytes;
    ptr<const uint32> $w = ($d:$ + $at) as ptr<const uint32>;
    return $w:$[0];
}

#[inline]
public function le64(string::view $b, usize $at = 0) : uint64
{
    need($b, $at, 8);
    ptr<const uint8> $d = $b->bytes;
    ptr<const uint64> $w = ($d:$ + $at) as ptr<const uint64>;
    return $w:$[0];
}

public function putBe16(string& $into, uint16 $v) : void
{
    $into->push(($v >> 8) as uint8);
    $into->push(($v & 0xFF) as uint8);
}

public function putBe32(string& $into, uint32 $v) : void
{
    $into->push(($v >> 24) as uint8);
    $into->push((($v >> 16) & 0xFF) as uint8);
    $into->push((($v >> 8) & 0xFF) as uint8);
    $into->push(($v & 0xFF) as uint8);
}

public function putBe64(string& $into, uint64 $v) : void
{
    putBe32($into, ($v >> 32) as uint32);
    putBe32($into, ($v & 0xFFFFFFFF) as uint32);
}

public function putLe16(string& $into, uint16 $v) : void
{
    $into->push(($v & 0xFF) as uint8);
    $into->push(($v >> 8) as uint8);
}

/**
 * The low three bytes of `$v`, low first. Bits above 24 are dropped: check the size first.
 */
public function putLe24(string& $into, uint32 $v) : void
{
    $into->push(($v & 0xFF) as uint8);
    $into->push((($v >> 8) & 0xFF) as uint8);
    $into->push((($v >> 16) & 0xFF) as uint8);
}

public function putLe32(string& $into, uint32 $v) : void
{
    putLe24($into, $v);
    $into->push(($v >> 24) as uint8);
}

public function putLe64(string& $into, uint64 $v) : void
{
    putLe32($into, ($v & 0xFFFFFFFF) as uint32);
    putLe32($into, ($v >> 32) as uint32);
}
