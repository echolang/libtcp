/**
 * Length-prefixed frames: a uint32 big-endian byte count, then that many bytes. The encoding is
 * pure, and `FrameReader` keeps a partial frame across short reads, so a thread can read with a
 * small timeout and check a stop flag without losing bytes.
 */

namespace tcp;

use std::time;

public const usize FRAME_HEADER = 4;

/**
 * The largest body a 4-byte prefix can announce.
 */
public const uint64 FRAME_MAX = 4294967295;

// one read takes at most this much off the socket
internal const usize FRAME_READ_CHUNK = 65536;

// a read into the rest of a large frame takes up to this much at once
internal const usize FRAME_READ_BIG = 1048576;

// writeFrame copies a body this size or smaller behind its prefix; a larger one is sent as is
internal const usize FRAME_COPY_MAX = 65536;

/**
 * The 4-byte prefix for a body of `$size` bytes. A `uint32`, so a larger size has to be checked
 * (`frameFits`) before it can be written down, never cut short.
 */
public function frameHeader(uint32 $n) : string
{
    string $out = '';
    $out->reserve(FRAME_HEADER);
    $out->push(($n >> 24) as uint8);
    $out->push((($n >> 16) & 0xFF) as uint8);
    $out->push((($n >> 8) & 0xFF) as uint8);
    $out->push(($n & 0xFF) as uint8);
    return $out;
}

/**
 * The length a prefix starting at `$at` of `$bytes` announces. `$bytes` holds four bytes there.
 */
public function frameLength(const string& $bytes, usize $at = 0) : uint64
{
    uint64 $b0 = $bytes->byte($at) as uint64;
    uint64 $b1 = $bytes->byte($at + 1) as uint64;
    uint64 $b2 = $bytes->byte($at + 2) as uint64;
    uint64 $b3 = $bytes->byte($at + 3) as uint64;
    return ($b0 << 24) | ($b1 << 16) | ($b2 << 8) | $b3;
}

/**
 * True when a body of `$size` bytes fits the prefix. A larger one cut to 32 bits would announce a
 * shorter frame, and the receiver would read the rest of the body as frames of its own.
 */
public function frameFits(uint64 $size) : bool
{
    return $size <= FRAME_MAX;
}

/**
 * `$body` with its prefix, ready for one send. `.tooLarge` past `FRAME_MAX`.
 */
public function frame(const string& $body) : result<string, Error>
{
    uint64 $size = $body->size() as uint64;
    if (!frameFits($size)) {
        return .error(.tooLarge($size));
    }

    string $out = frameHeader($size as uint32);
    $out->append($body);
    return .ok($out);
}

/**
 * Send `$body` as one frame within `$timeoutMs` in all.
 */
public function writeFrame(Stream $stream, const string& $body, int32 $timeoutMs = 5000) : status<Error>
{
    // a small frame is copied behind its prefix and goes out as one write, so it travels in one
    // packet; a large one is not worth a copy of itself, and goes out as prefix, then body
    if ($body->size() <= FRAME_COPY_MAX) {
        string $bytes = guard frame($body) else ($e) {
            return .error($e);
        }
        return $stream->writeAll($bytes, $timeoutMs);
    }

    uint64 $size = $body->size() as uint64;
    if (!frameFits($size)) {
        return .error(.tooLarge($size));
    }

    time::instant $start = time::instant::now();
    guard $stream->writeAll(frameHeader($size as uint32), $timeoutMs) else ($e) {
        return .error($e);
    }
    int32 $left = remainingMs($start, $timeoutMs);
    if ($left == 0 && $timeoutMs != 0) {
        return .error(.timeout);
    }

    return $stream->writeAll($body, $left);
}

/**
 * Turns the bytes of one connection back into frames. Bytes past a whole frame wait for the next
 * `take`; a partial frame waits for more bytes.
 */
public class FrameReader
{
    public const usize $max;
    public const int32 $idleMs;
    private string $pending;
    private time::instant $lastFrame;

    /**
     * `$max` caps the body of one frame; a prefix over it is an error, not an allocation.
     * `$idleMs` (-1 for none) ends a conversation that delivers no whole frame for that long,
     * counted from construction and from each frame: a server's guard against a peer that
     * holds a connection open and sends nothing, or a byte at a time.
     */
    public constructor(usize $max, int32 $idleMs = -1)
    {
        $this->max = $max;
        $this->idleMs = $idleMs;
        $this->pending = '';
        $this->lastFrame = time::instant::now();
    }

    /**
     * Bytes held that are not a whole frame yet.
     */
    public const function buffered() : usize
    {
        return $this->pending->size();
    }

    /**
     * Append raw bytes, as a read gave them.
     */
    public function feed(const string& $bytes) : void
    {
        $this->pending->append($bytes);
    }

    /**
     * The next whole frame's body, or null while it is not all here yet.
     */
    public function take() : result<string?, FrameError>
    {
        string? $none = null;
        usize $have = $this->pending->size();
        if ($have < FRAME_HEADER) {
            return .ok($none);
        }

        uint64 $size = frameLength($this->pending);
        if ($size > ($this->max as uint64)) {
            return .error(.tooLarge($size));
        }

        usize $need = FRAME_HEADER + ($size as usize);
        if ($have < $need) {
            return .ok($none);
        }

        // a body shares the read buffer, so one the caller keeps keeps all of it: a small body
        // pinning a buffer many times its size is copied out instead
        string $shared = $this->pending->sub(FRAME_HEADER, $size as usize);
        string? $body = $shared;
        if (($size as usize) * 2 < $this->pending->capacity()) {
            $body = $shared->clone();
        }
        $this->pending = $this->pending->sub($need, $have - $need);
        $this->lastFrame = time::instant::now();
        return .ok($body);
    }

    /**
     * The next frame off `$stream`, waiting up to `$timeoutMs` (-1 forever) for all of it, however
     * many reads it takes: null only when the timeout passed first. `.idle` once no frame came
     * within the idle limit, which also cuts a longer wait short. A partial frame is kept for the
     * next call.
     */
    public function read(Stream $stream, int32 $timeoutMs) : result<string?, FrameError>
    {
        time::instant $start = time::instant::now();
        bool $first = true;
        while (true) {
            string? $ready = guard $this->take() else ($e) {
                return .error($e);
            }
            if ($ready != null) {
                return .ok($ready);
            }

            int32 $left = remainingMs($start, $timeoutMs);
            int32 $idle = $this->idleLeftMs();

            // the first pass always reads once, so a frame already in the socket beats the limits
            if (!$first) {
                if ($idle == 0) {
                    return .error(.idle);
                }

                if ($left == 0) {
                    string? $none = null;
                    return .ok($none);
                }
            }
            $first = false;

            int32 $wait = $left;
            if ($idle >= 0 && ($wait < 0 || $idle < $wait)) {
                $wait = $idle;
            }

            usize $got = guard $stream->append($this->pending, $this->readSize(), $wait) else ($e) {
                bool $quiet = match ($e) {
                    Error::timeout => true,
                    else => false,
                };
                if ($quiet) {
                    // the checks at the top decide: a limit passed, or there is time left
                    continue;
                }

                return match ($e) {
                    Error::closed => $this->endOfStream(),
                    else => .error(.io($e->message())),
                };
            }
        }
    }

    /**
     * How much the next read takes: one chunk, or more once a prefix (already checked against
     * `$max`) says a large frame is still coming, so a big body takes fewer reads.
     */
    private const function readSize() : usize
    {
        usize $have = $this->pending->size();
        if ($have < FRAME_HEADER) {
            return FRAME_READ_CHUNK;
        }

        usize $missing = FRAME_HEADER + (frameLength($this->pending) as usize) - $have;
        if ($missing <= FRAME_READ_CHUNK) {
            return FRAME_READ_CHUNK;
        }

        if ($missing > FRAME_READ_BIG) {
            return FRAME_READ_BIG;
        }

        return $missing;
    }

    /**
     * What is left of the idle limit: -1 with none, 0 once it has passed.
     */
    private const function idleLeftMs() : int32
    {
        if ($this->idleMs < 0) {
            return -1;
        }

        int64 $left = ($this->idleMs as int64) - ($this->lastFrame->elapsed()->as_millis() as int64);
        if ($left <= 0) {
            return 0;
        }

        return $left as int32;
    }

    private const function endOfStream() : result<string?, FrameError>
    {
        if ($this->pending->empty()) {
            return .error(.closed);
        }

        return .error(.truncated);
    }
}
