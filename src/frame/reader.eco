/**
 * Turns the bytes of one connection back into frames. The core is free of I/O (`feed` in, `take`
 * out). `read` drives it from any `tcp::Source` under a deadline and keeps a partial frame;
 * `pull` drives it from a reactor. The idle limit lives here too: both paths go by `idleAt`.
 */

namespace tcp::frame;

use std::time;

public class Reader
{
    public const usize $max;
    // not a public const: echoc 0.8 cannot assign a const nullable struct field
    private time::duration? $idleLimit;
    private tcp::Reader $in;
    private time::instant $lastFrame;
    // false once a frame was taken and the idle clock has not been restarted for it yet
    private bool $stamped;

    /**
     * `$max` is the largest body; a prefix over it is an error, not an allocation. `$idle` is
     * how long the peer may go without a whole frame. The clock starts at construction and,
     * after each frame, at the next empty `take`, so time spent on a frame is not the peer's.
     * A byte a minute still counts as idle.
     */
    public constructor(max: usize $max, idle: time::duration? $idle = null)
    {
        $this->max = $max;
        $this->idleLimit = $idle;
        // the frame cap is checked here, against the prefix: the bytes reader only buffers
        usize $buffered = usize::max();
        if ($max <= usize::max() - HEADER) {
            $buffered = $max + HEADER;
        }
        $this->in = tcp::Reader(max: $buffered);
        $this->lastFrame = time::instant::now();
        $this->stamped = true;
    }

    public const function idle() : time::duration?
    {
        return $this->idleLimit;
    }

    /**
     * When the conversation goes idle: no whole frame by then. Never without a limit. `read`
     * answers `.idle` itself. A reactor waits no later than its readers' earliest, then `pull`s
     * once more, so a frame already in the socket beats the limit.
     */
    public const function idleAt() : tcp::Deadline
    {
        time::duration? $limit = $this->idleLimit;
        if ($limit == null) {
            return tcp::Deadline::never();
        }
        time::duration $span = guard $limit;
        return tcp::Deadline(at: $this->lastFrame + $span);
    }

    /**
     * Bytes held that are not a whole frame yet.
     */
    public const function buffered() : usize
    {
        return $this->in->buffered();
    }

    /**
     * Append raw bytes, as a read gave them.
     */
    public function feed(const string& $bytes) : void
    {
        $this->in->feed($bytes);
    }

    /**
     * The next whole frame's body, or null while it is not all here yet.
     */
    public function take() : result<string?, Error>
    {
        string? $none = null;
        string $prefix = guard $this->in->peek(HEADER) else {
            $this->settle();
            return .ok($none);
        }

        uint64 $size = length($prefix);
        if ($size > ($this->max as uint64)) {
            return .error(.tooLarge($size));
        }
        if ($this->in->buffered() < HEADER + ($size as usize)) {
            $this->settle();
            return .ok($none);
        }

        // no clock read here: `settle` restarts the idle clock once a take comes up empty, so
        // frames already in the buffer come out without a system call each
        $this->stamped = false;
        $this->in->skip(HEADER);
        string? $body = $this->in->take($size as usize);
        return .ok($body);
    }

    /**
     * The next frame off `$src`, waiting until the deadline for all of it however many reads it
     * takes: null only when the deadline passed first. `.idle` once no frame came within the
     * idle limit, which also cuts a longer wait short. A partial frame is kept for the next
     * call.
     */
    public function read<S : tcp::Source>(S $src, tcp::Deadline $by) : result<string?, Error>
    {
        bool $first = true;
        while (true) {
            string? $ready = guard $this->take() else ($e) {
                return .error($e);
            }
            if ($ready != null) {
                return .ok($ready);
            }

            tcp::Deadline $until = $by;
            if ($this->idleLimit != null) {
                $until = $by->earlier($this->idleAt());
            }
            // the first pass always reads once, so a frame already in the socket beats the limits
            if (!$first && $until->passed()) {
                if ($this->idleAt()->passed()) {
                    return .error(.idle);
                }
                string? $none = null;
                return .ok($none);
            }
            $first = false;

            tcp::Deadline? $wait = $until;
            result<usize?, tcp::Error> $got = $this->in->fillFor($src, $this->need(), $wait);
            if (!$got->has_value()) {
                return .error($this->failed($got->failure()));
            }
            // null: the wait ran out; the checks at the top say what that means
        }
    }

    /**
     * The next frame from what `$src` already has, without waiting. For a reactor: call until it
     * answers null, then wait on the `Poller`. Frames that arrived with the peer's close still
     * come out first, then `.end`, or `.truncated` if the close cut a frame short. `.idle` once
     * the limit has passed with the socket empty, so a frame already there still beats it.
     */
    public function pull<S : tcp::Source>(S $src) : result<string?, Error>
    {
        string? $none = null;
        tcp::Deadline? $now = null;
        while (true) {
            string? $ready = guard $this->take() else ($e) {
                return .error($e);
            }
            if ($ready != null) {
                return .ok($ready);
            }
            if ($this->in->ended()) {
                return .error($this->endOfStream());
            }

            result<usize?, tcp::Error> $got = $this->in->fillFor($src, $this->need(), $now);
            if (!$got->has_value()) {
                return .error($this->failed($got->failure()));
            }
            if ($got->unwrap() == null) {
                if ($this->idleAt()->passed()) {
                    return .error(.idle);
                }
                return .ok($none);
            }
        }
    }

    /**
     * How many bytes the frame being read needs from the read position: its prefix and body once
     * the prefix is here (already checked against `$max`), else 0 for unknown.
     */
    private const function need() : usize
    {
        string $prefix = guard $this->in->peek(HEADER) else {
            return 0;
        }
        return HEADER + (length($prefix) as usize);
    }

    /**
     * A failed read as a frame error: the end of the stream is `end` or `truncated`, anything
     * else is the connection's.
     */
    private const function failed(tcp::Error $e) : Error
    {
        bool $eof = match ($e) {
            tcp::Error::eof => true,
            else => false,
        };
        if ($eof) {
            return $this->endOfStream();
        }
        return .transport($e);
    }

    /**
     * Restarts the idle clock for the frames taken since it last ran.
     */
    private function settle() : void
    {
        if ($this->stamped) {
            return;
        }
        $this->stamped = true;
        if ($this->idleLimit != null) {
            $this->lastFrame = time::instant::now();
        }
    }

    private const function endOfStream() : Error
    {
        if ($this->in->buffered() == 0) {
            return .end;
        }
        return .truncated;
    }
}

/**
 * Send `$body` as one frame before the deadline: prefix and body in one gathered write, neither
 * copied.
 */
public function write<S : tcp::Sink>(S $dst, const string& $body, tcp::Deadline $by) : status<Error>
{
    uint64 $size = $body->size() as uint64;
    if (!fits($size)) {
        return .error(.tooLarge($size));
    }

    guard $dst->write(header($size as uint32), $body, $by) else ($e) {
        return .error(.transport($e));
    }
    return .ok;
}

/**
 * Queue `$body` as one frame on a reactor's `Outbox`: prefix, then body. `.tooLarge` past `MAX`,
 * and `.transport(.tooLarge)` past the outbox's `limit`, either way with nothing queued.
 */
public function push(tcp::Outbox $out, const string& $body) : status<Error>
{
    uint64 $size = $body->size() as uint64;
    if (!fits($size)) {
        return .error(.tooLarge($size));
    }

    guard $out->push(header($size as uint32), $body) else ($e) {
        return .error(.transport($e));
    }
    return .ok;
}
