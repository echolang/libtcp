/**
 * A listening TCP socket. `#[atomic]` so it can be built on one thread and served from others.
 * `close` is safe from any thread: an accept blocked on the listener wakes at once, and the port
 * is free as soon as no call is inside.
 */

namespace tcp;

#[atomic]
public class Listener : Pollable
{
    public const Address $local;
    // the backend's listener (c/tcp.h), and the socket inside it for a Poller
    private const int64 $listener;
    private const int64 $fd;
    private const StreamOptions $accepted;
    private Gate $gate;
    // a unix socket's file this listener made, removed when it is released: by its identity, so
    // never a file another listener has put on the path since
    private bool $removes;
    private tcp_file_id $file;

    internal constructor(int64 $listener, Address $local, StreamOptions $accepted)
    {
        $this->listener = $listener;
        $this->fd = tcp_listener_socket($listener);
        $this->local = $local;
        $this->accepted = $accepted;
        $this->gate = Gate();
        $this->removes = false;
        $this->file = tcp_file_id();
    }

    destructor()
    {
        if (!$this->gate->released()) {
            $this->release();
        }
    }

    /**
     * Bind and listen on `$at`. Port 0 lets the OS pick one; `$local->port` reads it back.
     *
     * A unix socket's file is made here and removed when the listener is released, unless
     * another listener has put a file of its own on the path since. A file left by a listener
     * that is gone (the process died) is replaced: one that refuses a connect is stale. A live
     * listener on the path stays `.addressInUse`, except on macOS when its backlog is full: macOS
     * refuses that connect exactly as a dead one's, so its path is taken over (it goes on serving
     * the connections it has). A file that is not a socket is never touched. The probe and the
     * removal go by the path, so its directory must not be writable by anyone untrusted: they
     * could swap what the path names in between.
     */
    public static function bind(const Address& $at, ListenOptions $options = ListenOptions()) : result<Listener, Error>
    {
        if ($at->family != Family::unix) {
            return Listener::listen($at, $options);
        }
        guard unixPath($at) else ($e) {
            return .error($e);
        }

        result<Listener, Error> $first = Listener::listen($at, $options);
        if (!$first->has_value()) {
            Error $e = $first->failure();
            if ($e->name() != 'addressInUse' || !Listener::stale($at)) {
                return $first;
            }
            $first = Listener::listen($at, $options);
        }
        if ($first->has_value()) {
            Listener $made = $first->unwrap();
            $made->own();
        }
        return $first;
    }

    /**
     * True when the file at a unix path is a socket nothing listens on any more, and it is gone
     * now. The backend probes it: only it can tell a dead listener from a busy one where the OS
     * can (c/tcp.h).
     */
    private static function stale(const Address& $at) : bool
    {
        string $path = cstrOf($at->path);
        return tcp_unlink_stale($path->cstr()) == 0;
    }

    /**
     * Takes on the socket file the bind just made, by its identity: the release removes that
     * file, and leaves one another listener has put on the path since.
     */
    private function own() : void
    {
        string $path = cstrOf($this->local->path);
        tcp_file_id $id = tcp_file_id();
        $this->removes = tcp_socket_id($path->cstr(), &$id) == 0;
        $this->file = $id;
    }

    private static function listen(const Address& $at, ListenOptions $options) : result<Listener, Error>
    {
        int32 $flags = 0;
        if ($options->reusePort) {
            $flags = $flags | TCP_LISTEN_REUSE_PORT;
        }
        if ($options->dualStack) {
            $flags = $flags | TCP_LISTEN_DUAL_STACK;
        }

        tcp_addr $raw = $at->raw();
        tcp_err $err = tcp_err();
        int64 $l = tcp_listen(&$raw, $options->backlog, $flags, &$err);
        if ($l < 0) {
            return .error(failure(.bind, $err));
        }

        tcp_addr $bound = tcp_addr();
        if (tcp_local(tcp_listener_socket($l), &$bound, &$err) < 0) {
            tcp_listener_close($l);
            return .error(failure(.bind, $err));
        }

        return .ok(Listener($l, Address(raw: $bound), $options->accepted));
    }

    /**
     * Resolve `$host` for listening and bind the first address that takes. Every interface is
     * spelled out, `0.0.0.0` or `::`: an empty host is refused, so nothing listens wider than
     * it asked.
     */
    public static function bind(host: const string& $host, uint16 $port, ListenOptions $options = ListenOptions()) : result<Listener, Error>
    {
        array<Address> $addrs = guard lookup($host, $port, passive: true) else ($e) {
            return .error($e);
        }

        Error $last = .invalid("{$host} has no address to listen on");
        foreach ($addrs as $a) {
            result<Listener, Error> $tried = Listener::bind($a, $options);
            if ($tried->has_value()) {
                return $tried;
            }
            $last = $tried->failure();
        }
        return .error($last);
    }

    /**
     * The next connection, or null when nobody connected before the deadline. `.closed` once
     * the listener is closed, also for an accept blocked when it happened. A connection the
     * peer reset before it could be set up is skipped, not reported.
     */
    public function accept(Deadline $by) : result<Stream?, Error>
    {
        return $this->next($by);
    }

    /**
     * The next connection if one is already waiting, else null. For a reactor. `.tooManyFiles`
     * leaves the connection waiting and the listener readable, so a level registration reports
     * it again at once: back off, or take the listener out of the poller until a descriptor is
     * free, or the loop spins.
     */
    public function tryAccept() : result<Stream?, Error>
    {
        return $this->next(null);
    }

    /**
     * Both accepts: wait up to `$by` for a connection, or not at all when there is no deadline.
     */
    private function next(Deadline? $by) : result<Stream?, Error>
    {
        Stream? $none = null;
        // what the backend answers when nobody connected: a wait that ran out, or a try too early
        int64 $quiet = TCP_AGAIN;
        if ($by != null) {
            $quiet = TCP_TIMEOUT;
        }

        while (true) {
            if (!$this->gate->enter()) {
                return .error(.closed);
            }

            tcp_addr $peer = tcp_addr();
            tcp_err $err = tcp_err();
            int64 $fd = TCP_AGAIN;
            if ($by == null) {
                $fd = tcp_try_accept($this->listener, &$peer, &$err);
            } else {
                Deadline $until = guard $by;
                $fd = tcp_accept($this->listener, $until->ms(), &$peer, &$err);
            }
            bool $closed = $this->leave();

            if ($fd == $quiet && !$closed) {
                return .ok($none);
            }
            result<Stream?, Error> $got = $this->adopted($fd, $peer, $err, $closed);
            // null: that connection died on the way in, and another may come (or wait) behind it
            if (!$got->has_value() || $got->unwrap() != null) {
                return $got;
            }
        }
    }

    /**
     * Stop listening, from any thread. An accept blocked on the listener wakes with `.closed`.
     */
    public function close() : void
    {
        int32 $inside = $this->gate->shut();
        if ($inside < 0) {
            return;
        }
        if ($inside > 0) {
            tcp_listener_cancel($this->listener);
        }
        $this->leave();
    }

    public const function closed() : bool
    {
        return $this->gate->has(GATE_CLOSED);
    }

    /**
     * A listener needs exactly what the caller wants: read, for the next connection.
     */
    public const function needs(Interest? $want) : Interest?
    {
        return $want;
    }

    /**
     * The OS descriptor, for a `Poller`: readable while a connection waits.
     */
    public const function handle() : int64
    {
        return $this->fd;
    }

    /**
     * Counts a call out of the gate, and releases the listener when it was the last one in after
     * a close. True when the listener was closed by the time the call left.
     */
    private function leave() : bool
    {
        Exit $exit = $this->gate->leave();
        if ($exit->last) {
            $this->release();
        }
        return $exit->closed;
    }

    /**
     * Give the socket back, and the file of a unix one this listener made.
     */
    private function release() : void
    {
        tcp_listener_close($this->listener);
        if ($this->removes) {
            string $path = cstrOf($this->local->path);
            tcp_file_id $id = $this->file;
            tcp_unlink_socket($path->cstr(), &$id);
        }
    }

    /**
     * An accepted descriptor as a stream: null when the peer reset it before its setup was done,
     * which is that connection's failure and not the listener's.
     */
    private function adopted(int64 $fd, const tcp_addr& $peer, const tcp_err& $err, bool $closed) : result<Stream?, Error>
    {
        Stream? $none = null;
        if ($fd < 0) {
            return .error(outcome(.accept, $fd, $err, $closed));
        }
        // the accept won a race with close: the listener is closed all the same
        if ($closed) {
            tcp_close($fd);
            return .error(.closed);
        }

        // a connection to a listener on one address arrived at that address: no getsockname. One
        // on 0.0.0.0 or :: arrived at some interface, and only the OS knows which
        Address? $local = null;
        if (!$this->local->unspecified()) {
            $local = $this->local;
        }
        result<Stream, Error> $made = Stream::adopt($fd, Address(raw: $peer), $this->accepted, .accept, $local);
        if (!$made->has_value()) {
            Error $e = $made->failure();
            return match ($e) {
                Error::reset($sys) => .ok($none),
                else => .error($e),
            };
        }
        Stream? $got = $made->unwrap();
        return .ok($got);
    }
}
