/**
 * Helpers the socket tests share. Each one dies with a sentence instead of handing a failure back,
 * so a test reads as the behaviour it checks.
 */

use std::time;

internal function ms(int64 $n) : tcp::Deadline
{
    return tcp::Deadline(ms: $n);
}

internal function listenLocal() : tcp::Listener
{
    tcp::Listener $l = guard tcp::Listener::bind(tcp::Address(loopback: 0)) else ($e) {
        die("listen: {$e}");
    }
    return $l;
}

internal function connectLocal(uint16 $port) : tcp::Stream
{
    tcp::Stream $s = guard tcp::Stream::connect(tcp::Address(loopback: $port), ms(5000)) else ($e) {
        die("connect: {$e}");
    }
    return $s;
}

/**
 * Two connected streams, for a test that needs no listener of its own.
 */
internal function connectedPair() : tcp::StreamPair
{
    tcp::StreamPair $pair = guard tcp::Stream::pair(ms(5000)) else ($e) {
        die("pair: {$e}");
    }
    return $pair;
}

/**
 * The next connection on `$l`, waiting up to five seconds.
 */
internal function acceptOne(tcp::Listener $l) : tcp::Stream
{
    tcp::Stream? $maybe = guard $l->accept(ms(5000)) else ($e) {
        die("accept: {$e}");
    }
    tcp::Stream $s = guard $maybe else {
        die('no client connected within 5 s');
    }
    return $s;
}

/**
 * The name of an error's case, so a test can say which one it expects in one line.
 */
internal function kind(const tcp::Error& $e) : string
{
    return $e->name();
}

/**
 * The case a failed result carries, or 'ok'.
 */
internal function failed<T>(result<T, tcp::Error> $r) : string
{
    if ($r->has_value()) {
        return 'ok';
    }
    return kind($r->failure());
}

internal function failedStatus(status<tcp::Error> $r) : string
{
    if ($r->has_value()) {
        return 'ok';
    }
    return kind($r->failure());
}

internal function frameKind(const tcp::frame::Error& $e) : string
{
    return $e->name();
}

internal function frameFailed<T>(result<T, tcp::frame::Error> $r) : string
{
    if ($r->has_value()) {
        return 'ok';
    }
    return frameKind($r->failure());
}

internal function frameFailedStatus(status<tcp::frame::Error> $r) : string
{
    if ($r->has_value()) {
        return 'ok';
    }
    return frameKind($r->failure());
}

/**
 * `$n` bytes counting 0..250 over and over: a chunk dropped, repeated or reordered shows up as a
 * byte out of step, which a run of one value would hide.
 */
internal function pattern(usize $n) : string
{
    string $out = '';
    $out->reserve($n);
    usize $i = 0;
    while ($i < $n) {
        $out->push(($i % 251) as uint8);
        $i = $i + 1;
    }
    return $out;
}

/**
 * The index of the first byte where `$a` and `$b` differ, or -1 when they are equal.
 */
internal function firstDiff(const string& $a, const string& $b) : int64
{
    usize $n = $a->size();
    if ($b->size() < $n) {
        $n = $b->size();
    }
    usize $i = 0;
    while ($i < $n) {
        if ($a->byte($i) != $b->byte($i)) {
            return $i as int64;
        }
        $i = $i + 1;
    }
    if ($a->size() != $b->size()) {
        return $n as int64;
    }
    return -1;
}

/**
 * One frame off `$s` in one call, as `frame::Reader::read` promises before its deadline.
 */
internal function readFrame(tcp::Stream $s, tcp::frame::Reader $r, int64 $timeoutMs) : string
{
    string? $got = guard $r->read($s, ms($timeoutMs)) else ($e) {
        die("read: {$e}");
    }
    string $body = guard $got else {
        die("no frame within {$timeoutMs} ms");
    }
    return $body;
}

internal function sendFrame(tcp::Stream $s, const string& $body) : void
{
    guard tcp::frame::write($s, $body, ms(5000)) else ($e) {
        die("write frame: {$e}");
    }
}

internal function send(tcp::Stream $s, const string& $bytes) : void
{
    guard $s->write($bytes, ms(5000)) else ($e) {
        die("write: {$e}");
    }
}

/**
 * Everything `$s` delivers until the peer closes, giving up after `$timeoutMs` in all.
 */
internal function readToEnd(tcp::Stream $s, int64 $timeoutMs) : string
{
    string $all = '';
    status<tcp::Error> $read = tcp::readAll($s, $all, ms($timeoutMs));
    if (!$read->has_value()) {
        string $why = kind($read->failure());
        die("read: {$why} after {$all->size()} bytes");
    }
    return $all;
}

internal function elapsedMs(time::instant $since) : int64
{
    return $since->elapsed()->as_millis() as int64;
}

/**
 * `assert` with a message built at run time: `assert` only takes a literal.
 */
internal function expect(bool $ok, const string& $why) : void
{
    if (!$ok) {
        die($why);
    }
}
