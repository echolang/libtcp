/**
 * Frames without a socket: the prefix, and the reader over bytes fed in pieces.
 */

test tcp_frame_header_is_big_endian
{
    string $h = tcp::frame::header(0x01020304);
    assert($h->size() == 4, 'four bytes');
    assert($h->byte(0) == 1 && $h->byte(3) == 4, 'most significant first');
    assert(tcp::frame::length($h) == 0x01020304, 'round trip');
}

test tcp_frame_header_extremes
{
    string $zero = tcp::frame::header(0);
    assert($zero->size() == 4 && $zero->byte(0) == 0 && $zero->byte(3) == 0, 'zero is four zero bytes');
    string $max = tcp::frame::header(0xFFFFFFFF);
    assert($max->byte(0) == 255 && $max->byte(1) == 255 && $max->byte(2) == 255 && $max->byte(3) == 255, 'the largest is four 0xFF');
    assert(tcp::frame::length($max) == tcp::frame::MAX, 'reads back as MAX, not a negative');
    assert(tcp::frame::HEADER == 4, 'a four-byte prefix');
}

test tcp_frame_length_reads_at_an_offset
{
    string $bytes = 'ab';
    $bytes->append(tcp::frame::header(70000));
    assert(tcp::frame::length($bytes, 2) == 70000, 'the prefix after two bytes');
}

internal function framed(const string& $body) : string
{
    string $out = guard tcp::frame::encode($body) else ($e) {
        die("encode: {$e}");
    }
    return $out;
}

test tcp_frame_is_prefix_then_body
{
    string $f = framed('abc');
    assert($f->size() == 7, 'four plus three');
    assert(tcp::frame::length($f) == 3, 'announces three');
    assert($f->sub(4, 3) == 'abc', 'then the body, untouched');
}

test tcp_frame_carries_any_bytes
{
    string $body = '';
    $body->push(0);
    $body->push(255);
    $body->push(13);
    $body->push(10);
    $body->push(0);
    tcp::frame::Reader $reader = tcp::frame::Reader(max: 16);
    $reader->feed(framed($body));
    string? $got = guard $reader->take() else ($e) {
        die("take: {$e}");
    }
    string $b = guard $got else {
        die('no frame');
    }
    assert($b->size() == 5, 'NUL bytes do not end it');
    assert(firstDiff($b, $body) == -1, 'byte for byte');
}

test tcp_frame_round_trip_in_pieces
{
    string $wire = framed('first');
    $wire->append(framed(''));
    $wire->append(framed('second'));
    tcp::frame::Reader $reader = tcp::frame::Reader(max: 1024);
    usize $i = 0;
    array<string> $got = array<string>();
    while ($i < $wire->size()) {
        $reader->feed($wire->sub($i, 1));
        $i = $i + 1;
        string? $body = guard $reader->take() else ($e) {
            die("take: {$e}");
        }
        if ($body != null) {
            string $b = guard $body;
            $got[] = $b;
        }
    }
    assert($got->count() == 3, 'three frames, one byte at a time');
    assert($got[0] == 'first', 'first body');
    assert($got[1]->empty(), 'an empty frame');
    assert($got[2] == 'second', 'third body');
    assert($reader->buffered() == 0, 'nothing left over');
}

test tcp_frame_reader_waits_for_the_whole_frame
{
    tcp::frame::Reader $reader = tcp::frame::Reader(max: 1024);
    string $wire = framed('hello');
    $reader->feed($wire->sub(0, 3));
    string? $short = guard $reader->take() else ($e) {
        die("take: {$e}");
    }
    assert($short == null && $reader->buffered() == 3, 'part of a prefix: nothing yet, three held');
    $reader->feed($wire->sub(3, 3));
    string? $partial = guard $reader->take() else ($e) {
        die("take: {$e}");
    }
    assert($partial == null && $reader->buffered() == 6, 'a prefix and part of the body: nothing yet');
    $reader->feed($wire->sub(6, 3));
    string? $whole = guard $reader->take() else ($e) {
        die("take: {$e}");
    }
    assert(($whole ?? '-') == 'hello' && $reader->buffered() == 0, 'the rest: the frame');
    string? $empty = guard $reader->take() else ($e) {
        die("take: {$e}");
    }
    assert($empty == null, 'nothing more');
}

test tcp_frame_many_in_one_feed
{
    string $wire = framed('one');
    $wire->append(framed('two'));
    $wire->append(framed('three'));
    $wire->append(framed('fo'));
    tcp::frame::Reader $reader = tcp::frame::Reader(max: 1024);
    $reader->feed($wire->sub(0, $wire->size() - 1));
    array<string> $got = array<string>();
    while (true) {
        string? $body = guard $reader->take() else ($e) {
            die("take: {$e}");
        }
        if ($body == null) {
            break;
        }
        string $b = guard $body;
        $got[] = $b;
    }
    assert($got->count() == 3, 'three whole frames and part of a fourth');
    assert($got[0] == 'one' && $got[1] == 'two' && $got[2] == 'three', 'in order');
    assert($reader->buffered() == 5, 'the fourth waits: prefix and one byte');
}

test tcp_frame_small_frames_take_in_linear_time
{
    usize $count = 100000;
    string $wire = '';
    $wire->reserve($count * 5);
    usize $i = 0;
    while ($i < $count) {
        $wire->append(tcp::frame::header(1));
        $wire->push(($i % 251) as uint8);
        $i = $i + 1;
    }
    tcp::frame::Reader $reader = tcp::frame::Reader(max: 16);
    $reader->feed($wire);
    std::time::instant $t = std::time::instant::now();
    usize $n = 0;
    while (true) {
        string? $body = guard $reader->take() else ($e) {
            die("take: {$e}");
        }
        if ($body == null) {
            break;
        }
        string $b = guard $body;
        assert($b->size() == 1 && $b->byte(0) == ($n % 251) as uint8, 'in order');
        $n = $n + 1;
    }
    int64 $spent = elapsedMs($t);
    assert($n == $count, 'every frame');
    expect($spent < 1000, "100000 one-byte frames took {$spent} ms");
}

test tcp_frame_small_body_does_not_hold_the_buffer
{
    // a small frame, then most of a large one: the small body comes out of a 100 KiB buffer
    string $wire = framed('small');
    $wire->append(tcp::frame::header(200000));
    $wire->append(pattern(100000));
    tcp::frame::Reader $reader = tcp::frame::Reader(max: 1024 * 1024);
    $reader->feed($wire);
    string? $got = guard $reader->take() else ($e) {
        die("take: {$e}");
    }
    string $body = guard $got else {
        die('no frame');
    }
    assert($body == 'small', 'the small body');
    usize $held = $body->capacity();
    expect($held < 1024, "a 5-byte body kept {$held} bytes alive");
}

test tcp_frame_large_body_is_not_copied_out
{
    string $wire = framed(pattern(100000));
    tcp::frame::Reader $reader = tcp::frame::Reader(max: 1024 * 1024);
    $reader->feed($wire);
    string? $got = guard $reader->take() else ($e) {
        die("take: {$e}");
    }
    string $body = guard $got else {
        die('no frame');
    }
    assert(firstDiff($body, pattern(100000)) == -1, 'the body, intact');
}

internal function tooLargeSize(result<string?, tcp::frame::Error> $r) : uint64
{
    if ($r->has_value()) {
        return 0;
    }
    return match ($r->failure()) {
        tcp::frame::Error::tooLarge($size) => $size,
        else => 0,
    };
}

test tcp_frame_refuses_http_text
{
    tcp::frame::Reader $reader = tcp::frame::Reader(max: 16 * 1024 * 1024);
    $reader->feed('GET / HTTP/1.1\r\n');
    expect(tooLargeSize($reader->take()) > 1000000000, 'an HTTP request line reads as an oversized frame');
}

test tcp_frame_cap_is_inclusive_and_sticky
{
    tcp::frame::Reader $ok = tcp::frame::Reader(max: 3);
    $ok->feed(framed('abc'));
    string? $at = guard $ok->take() else ($e) {
        die("a body of exactly max: {$e}");
    }
    assert(($at ?? '-') == 'abc', 'a body of exactly max is taken');

    tcp::frame::Reader $over = tcp::frame::Reader(max: 3);
    $over->feed(framed('abcd'));
    expect(tooLargeSize($over->take()) == 4, 'one over max is tooLarge with the announced size');
    expect(tooLargeSize($over->take()) == 4, 'and stays that way: the stream is not frames');

    tcp::frame::Reader $none = tcp::frame::Reader(max: 0);
    $none->feed(framed(''));
    string? $empty = guard $none->take() else ($e) {
        die("take: {$e}");
    }
    assert(($empty ?? '-') == '', 'a cap of zero still takes empty frames');
}

test tcp_frame_size_must_fit_the_prefix
{
    assert(tcp::frame::fits(0), 'empty');
    assert(tcp::frame::fits(4294967295), 'the largest a prefix holds');
    assert(!tcp::frame::fits(4294967296), 'one past it would wrap to an empty frame');
    assert(!tcp::frame::fits(4294967296 + 5), 'or to a short one');
}

test tcp_frame_errors_read_as_sentences
{
    tcp::frame::Error $over = tcp::frame::Error::tooLarge(99);
    assert($over->message()->contains('99'), 'tooLarge names the size');
    tcp::frame::Error $cut = tcp::frame::Error::truncated;
    assert($cut->message() != tcp::frame::Error::end->message(), 'truncated is not a clean close');
    tcp::frame::Error $wrapped = tcp::frame::Error::transport(tcp::Error::timeout);
    assert("{$wrapped}" == 'timed out', 'a transport failure reads as its cause');
}

internal function taken(tcp::frame::Reader& $reader) : string?
{
    string? $got = guard $reader->take() else ($e) {
        die("take: {$e}");
    }
    return $got;
}

test tcp_frame_idle_limit_works_without_a_read
{
    tcp::frame::Reader $none = tcp::frame::Reader(max: 16);
    assert(!$none->idleAt()->passed(), 'no limit: never idle');

    tcp::frame::Reader $reader = tcp::frame::Reader(max: 16, idle: std::time::duration::millis(30));
    assert(!$reader->idleAt()->passed(), 'not idle yet');
    std::thread::sleep(50);
    assert($reader->idleAt()->passed(), 'no frame in 30 ms: idle, with nothing but feed and take');

    // a frame, then the take that comes up empty, restarts the clock
    $reader->feed(framed('hi'));
    assert((taken($reader) ?? '-') == 'hi', 'the frame');
    assert($reader->idleAt()->passed(), 'the clock restarts only once a take finds nothing');
    assert(taken($reader) == null, 'nothing more');
    assert(!$reader->idleAt()->passed(), 'restarted');
}

test tcp_frame_a_trickle_does_not_reset_the_idle_clock
{
    tcp::frame::Reader $reader = tcp::frame::Reader(max: 16, idle: std::time::duration::millis(30));
    string $f = framed('abc');
    $reader->feed($f->sub(0, 2));
    assert(taken($reader) == null, 'half a prefix');
    std::thread::sleep(50);
    $reader->feed($f->sub(2, 2));
    assert(taken($reader) == null, 'still not a whole frame');
    assert($reader->idleAt()->passed(), 'bytes that are not a frame do not count');
}
